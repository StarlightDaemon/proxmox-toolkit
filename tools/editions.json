{
    "version": "0.8.0-dev.1",
    "repository": "https://github.com/StarlightDaemon/proxmox-toolkit",
    "editions": [
        {
            "id": "toolkit",
            "name": "Proxmox Toolkit",
            "file": "proxmox-toolkit.user.js",
            "features": [
                "COPY",
                "PASTE_ONLY",
                "PASTE",
                "EXPORT",
                "DIAGNOSTICS",
                "RECIPES",
                "SCOPED",
                "FIND",
                "REVIEW",
                "SERIAL",
                "CUSTOM_PORT",
                "INVENTORY",
                "COMPARE",
                "BACKUPS",
                "TASKS",
                "TASK_REPORT",
                "SNAPSHOTS",
                "STORAGE",
                "MAINTENANCE",
                "NETWORK",
                "GUEST_HEALTH",
                "RECOVERY",
                "CAPACITY",
                "DRIFT",
                "SUPPORT",
                "FIREWALL",
                "UPDATES"
            ],
            "description": "Configurable console tools and read-only management reports for Proxmox VE."
        },
        {
            "id": "copy-paste",
            "name": "Proxmox Copy & Paste",
            "file": "proxmox-copy-paste.user.js",
            "features": [
                "COPY",
                "PASTE_ONLY",
                "PASTE"
            ],
            "configurable": true,
            "description": "Copy, Paste & Execute and Paste Only with persistent feature toggles for Proxmox consoles."
        }
    ]
}
